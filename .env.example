# ============================================
# DJANGO SETTINGS
# ============================================

SECRET_KEY=your-secret-key-here
DEBUG=True
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================
# DATABASE
# ============================================

# SQLite (Development)
DB_ENGINE=django.db.backends.sqlite3
DB_NAME=db.sqlite3

# PostgreSQL (Production)
# DB_ENGINE=django.db.backends.postgresql
# DB_NAME=adiblar_merosi
# DB_USER=postgres
# DB_PASSWORD=your_password
# DB_HOST=localhost
# DB_PORT=5432
# Eslatma: DB_HOST ga to'liq URL emas, faqat host yoziladi.
# Masalan: dpg-xxxxxx-a
# Muqobil variant (bitta qatorda):
# DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DB_NAME

# ============================================
# FRONTEND CORS
# ============================================

CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://localhost:5173
# Vercel preview domenlari uchun (ixtiyoriy)
CORS_ALLOWED_ORIGIN_REGEXES=https://.*\.vercel\.app

# ============================================
# EMAIL (SendGrid, AWS SES yoki smtp)
# ============================================

EMAIL_BACKEND=django.core.mail.backends.console.EmailBackend
EMAIL_HOST=localhost
EMAIL_PORT=1025
EMAIL_USE_TLS=False
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
DEFAULT_FROM_EMAIL=noreply@adiblarmerosi.com

# ============================================
# AI CHAT (Optional)
# ============================================

OPENAI_API_KEY=
OPENAI_CHAT_MODEL=gpt-4.1-mini

# ============================================
# REDIS (Optional)
# ============================================

REDIS_URL=redis://127.0.0.1:6379/1

# ============================================
# PRODUCTION (Render + Vercel) MISOLI
# ============================================
# DEBUG=False
# DEBUG_PROPAGATE_EXCEPTIONS=False
# ALLOWED_HOSTS=your-backend.onrender.com
# CORS_ALLOWED_ORIGINS=https://your-frontend.vercel.app
# CSRF_TRUSTED_ORIGINS=https://your-frontend.vercel.app,https://your-backend.onrender.com
# SERVE_MEDIA=True

# ============================================
# RENDER FREE: AUTO SUPERUSER (ixtiyoriy)
# ============================================
# CREATE_SUPERUSER_ON_DEPLOY=true
# DJANGO_SUPERUSER_USERNAME=admin
# DJANGO_SUPERUSER_EMAIL=admin@example.com
# DJANGO_SUPERUSER_PASSWORD=StrongPassword123!

# ============================================
# SUPABASE STORAGE (Render media uchun tavsiya)
# ============================================
# USE_SUPABASE_STORAGE=True
# SUPABASE_URL=https://xxxx.supabase.co
# Eslatma: /rest/v1 yoki /storage/v1 qo'shmang
# SUPABASE_KEY=your-anon-or-service-role-key
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_BUCKET_NAME=media
# SUPABASE_BUCKET_PUBLIC=True
# SUPABASE_MEDIA_PREFIX=
# SUPABASE_MEDIA_CACHE_CONTROL=3600
# SUPABASE_MEDIA_UPSERT=true
# SUPABASE_SIGNED_URL_EXPIRES=3600
# SERVE_MEDIA=False
